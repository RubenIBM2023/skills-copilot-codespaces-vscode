          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"description\": \"Falta nombre y otros campos\",\n  \"price\": -100,\n  \"stock\": -5,\n  \"category\": \"\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/products",
              "protocol": "http",
              "host": ["localhost"],
