              "path": ["api", "v1", "products"]
            }
          },
          "response": []
        },
        {
          "name": "Error: Producto No Existe (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/v1/products/invalid-id-12345",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "products", "invalid-id-12345"]
