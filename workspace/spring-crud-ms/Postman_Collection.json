  "item": [
    {
      "name": "1. CREAR PRODUCTO",
      "item": [
        {
          "name": "1.1 - Crear Laptop (Éxito)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop Dell XPS 13\",\n  \"description\": \"Laptop ultraportátil con procesador Intel Core i7\",\n  \"price\": 1299.99,\n  \"stock\": 5,\n  \"category\": \"Electronics\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/products",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "products"]
            },
            "description": "Crear un producto válido. Esperar 201 Created con ID generado."
          },
          "response": []
        },
