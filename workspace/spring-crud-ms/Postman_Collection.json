              "mode": "raw",
              "raw": "{\n  \"price\": 1199.99\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/products/{{PRODUCT_ID}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "products", "{{PRODUCT_ID}}"]
            },
            "description": "Actualización parcial: solo cambiar precio"
