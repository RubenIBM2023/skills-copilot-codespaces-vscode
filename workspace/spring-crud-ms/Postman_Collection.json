    {
      "name": "2. LEER PRODUCTOS",
      "item": [
        {
          "name": "2.1 - Obtener Todos (Sin Paginación)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/api/v1/products",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "products"]
            },
            "description": "Obtener lista de todos los productos"
          },
          "response": []
        },
        {
          "name": "2.2 - Obtener Todos (Con Paginación)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/api/v1/products?page=0&size=10",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "products"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            },
            "description": "Obtener productos con paginación (página 0, 10 items por página)"
          },
          "response": []
        },
        {
          "name": "2.3 - Obtener Producto por ID (Success)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/api/v1/products/{{PRODUCT_ID}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "products", "{{PRODUCT_ID}}"]
            },
            "description": "Obtener un producto específico por ID. Usar la variable {{PRODUCT_ID}} guardada de respuesta anterior."
          },
          "response": []
        },
        {
          "name": "2.4 - Obtener Producto No Existe (404)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/api/v1/products/invalid_id_000000000000",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "products", "invalid_id_000000000000"]
            },
            "description": "Intentar obtener producto que no existe. Esperar 404 Not Found."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. ACTUALIZAR PRODUCTO",
      "item": [
        {
          "name": "3.1 - PUT: Actualizar Completo",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop Dell XPS 13 Actualizada\",\n  \"description\": \"Laptop ultraportátil con procesador Intel Core i9\",\n  \"price\": 1499.99,\n  \"stock\": 8,\n  \"category\": \"Premium Electronics\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/products/{{PRODUCT_ID}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "products", "{{PRODUCT_ID}}"]
            },
            "description": "Actualizar todos los campos del producto (PUT). Usar {{PRODUCT_ID}} de pasos anteriores."
          },
          "response": []
        },
        {
          "name": "3.2 - PATCH: Actualizar Solo Precio",
